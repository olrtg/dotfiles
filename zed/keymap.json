[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": { "j k": "vim::NormalBefore" },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space w": "workspace::Save",
      "space q": "pane::CloseActiveItem",
      "space c": "pane::CloseActiveItem",
      "space f": "file_finder::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space t": "task::Spawn",
      "space s t": "workspace::NewSearch",
      "space l d": "diagnostics::Deploy",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "ctrl-\\": "terminal_panel::ToggleFocus",
      "ctrl-l": "buffer_search::Dismiss",

      // Git
      "] g": "editor::GoToHunk",
      "[ g": "editor::GoToPreviousHunk",
      "space g l": "git::Blame",
      "space g b": "git::BranchDiff",

      // LSP
      "g l": "editor::Hover",
      "g r r": "editor::FindAllReferences",
      "g r a": "editor::ToggleCodeActions",
      "g r n": "editor::Rename",
      "g D": "editor::GoToDeclaration",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
    },
  },

  /*
   * Incremental selection
   */
  {
    "context": "Editor && !showing_code_actions && vim_mode == normal || vim_mode == visual",
    "bindings": {
      "enter": "editor::SelectLargerSyntaxNode",
      "backspace": "editor::SelectSmallerSyntaxNode",
    },
  },

  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "q": "workspace::ToggleLeftDock",
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
    },
  },

  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCodeAction",
      "j": "editor::ContextMenuNext",
      "k": "editor::ContextMenuPrevious",
      "q": "editor::Cancel",
    },
  },

  {
    "context": "Terminal",
    "bindings": { "ctrl-\\": "workspace::ToggleBottomDock" },
  },

  {
    "context": "Dock",
    "bindings": {
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w l": "workspace::ActivatePaneRight",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w j": "workspace::ActivatePaneDown",
    },
  },

  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-s": ["vim::PushAddSurrounds", {}],
    },
  },

  // Lazygit
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space g g": [
        "task::Spawn",
        { "task_name": "start lazygit", "reveal_target": "center" },
      ],
      "space g f": [
        "task::Spawn",
        { "task_name": "start lazygit file log", "reveal_target": "center" },
      ],

      "space i": [
        "task::Spawn",
        { "task_name": "start agent", "reveal_target": "center" },
      ],
    },
  },
]
