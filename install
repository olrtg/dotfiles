#!/usr/bin/env bash
# Symlink dotfiles into $HOME. Safe to re-run.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# <path in repo> <target>
LINKS="
ghostty                      $HOME/.config/ghostty
mise/config.toml             $HOME/.config/mise/config.toml
mise/default-npm-packages    $HOME/.default-npm-packages
nvim                         $HOME/.config/nvim
single/.gitconfig            $HOME/.gitconfig
single/.ignore               $HOME/.ignore
zed                          $HOME/.config/zed
zsh/.zprofile                $HOME/.zprofile
zsh/.zshrc                   $HOME/.zshrc
"

link() {
	local src="$DOTFILES/$1" dst="$2"

	if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
		return
	fi

	mkdir -p "$(dirname "$dst")"

	if [ -e "$dst" ] && [ ! -L "$dst" ]; then
		local backup="$dst.backup-$(date +%Y%m%d%H%M%S)"
		mv "$dst" "$backup"
		echo "backed up $dst -> $backup"
	fi

	ln -sfn "$src" "$dst"
	echo "linked $dst"
}

# Remove dangling symlinks that point into this repo, left behind by deleted configs
clean() {
	local dir="$1" entry
	for entry in "$dir"/.* "$dir"/*; do
		if [ -L "$entry" ] && [ ! -e "$entry" ] && [[ "$(readlink "$entry")" == "$DOTFILES"/* ]]; then
			rm "$entry"
			echo "removed dangling $entry"
		fi
	done
}

git -C "$DOTFILES" submodule update --init --recursive

echo "$LINKS" | while read -r src dst; do
	if [ -n "$src" ]; then link "$src" "$dst"; fi
done

# mise treats mise/config.toml inside the repo as a project config
if command -v mise >/dev/null; then mise trust --quiet "$DOTFILES/mise/config.toml"; fi

clean "$HOME"
clean "$HOME/.config"
clean "$HOME/.local/bin"
