#!/usr/bin/env bash

PATHS=$(find ~/d -maxdepth 1 -type d)

# use fzf to select a folder
SELECTED=$(echo -e "$PATHS" | fzf)

# if no folder was selected, exit
if [[ -z $SELECTED ]]; then
	exit 0
fi

# grab the name of the selected folder and replace the spaces with underscores
SESSION_NAME=$(basename "$SELECTED" | tr . _)

TMUX_RUNNING=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $TMUX_RUNNING ]]; then
	tmux new-session -s "$SESSION_NAME" -c "$SELECTED"
	exit 0
fi

if ! tmux has-session -t="$SESSION_NAME" 2>/dev/null; then
	tmux new-session -ds "$SESSION_NAME" -c "$SELECTED"

	if [ $SESSION_NAME = "denguechatPlus-backend" ]; then
		tmux rename-window -t 1 nvim
		tmux set -w -t 1 allow-rename off
		tmux send-keys -t 1 'nvim' Enter

		tmux new-window -n dev-server -c "$SELECTED"
		tmux set -w -t 2 allow-rename off
		tmux send-keys -t 2 'rails s'

		tmux new-window -n codex -c "$SELECTED"
		tmux set -w -t 3 allow-rename off
		tmux send-keys -t 3 'codex'

		tmux select-window -t 1
	fi

	if [ $SESSION_NAME = "denguechatPlus-mobile" ]; then
		tmux rename-window -t 1 nvim
		tmux set -w -t 1 allow-rename off
		tmux send-keys -t 1 'nvim' Enter

		tmux new-window -n dev-server -c "$SELECTED"
		tmux set -w -t 2 allow-rename off
		tmux send-keys -t 2 'nr start'

		tmux new-window -n codex -c "$SELECTED"
		tmux set -w -t 3 allow-rename off
		tmux send-keys -t 3 'codex'

		tmux select-window -t 1
	fi

	if [ $SESSION_NAME = "denguechatPlus-web" ]; then
		tmux rename-window -t 1 nvim
		tmux set -w -t 1 allow-rename off
		tmux send-keys -t 1 'nvim' Enter

		tmux new-window -n dev-server -c "$SELECTED"
		tmux set -w -t 2 allow-rename off
		tmux send-keys -t 2 'nr dev'

		tmux new-window -n codex -c "$SELECTED"
		tmux set -w -t 3 allow-rename off
		tmux send-keys -t 3 'codex'

		tmux select-window -t 1
	fi
fi

tmux switch-client -t "$SESSION_NAME"
